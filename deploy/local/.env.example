# Copy to .env and adjust.

# Prompt/response content logging:
#   off = metadata only (tokens, model, latency, cost)  <- default, safest
#   on  = prompts and responses are also stored in Loki
PROMPT_LOGGING=off

# Only needed for the optional LiteLLM gateway (--profile gateway).
# Apps send LITELLM_MASTER_KEY as their API key. Change it on shared machines.
LITELLM_MASTER_KEY=sk-local-dev
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
