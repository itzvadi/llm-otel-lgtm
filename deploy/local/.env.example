# Copy to .env and adjust.

# Prompt/response content logging:
#   off = metadata only (tokens, model, latency, cost)  <- default, safest
#   on  = prompts and responses are also stored in Loki
PROMPT_LOGGING=off

# Demo generator: true = simulated traffic, false = real API calls (needs keys)
LLM_MOCK=true

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
