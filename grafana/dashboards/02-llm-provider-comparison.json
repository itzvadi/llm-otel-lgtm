{
  "uid": "llm-provider-comparison",
  "title": "LLM Provider Comparison",
  "description": "Compare OpenAI, Claude and Grok on latency, reliability and cost.",
  "tags": [
    "llm",
    "opentelemetry"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(llm_requests_total, job)",
          "refId": "service"
        },
        "definition": "label_values(llm_requests_total, job)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "provider",
        "label": "Provider",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(llm_requests_total{job=~\"$service\"}, provider)",
          "refId": "provider"
        },
        "definition": "label_values(llm_requests_total{job=~\"$service\"}, provider)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(llm_requests_total{job=~\"$service\", provider=~\"$provider\"}, model)",
          "refId": "model"
        },
        "definition": "label_values(llm_requests_total{job=~\"$service\", provider=~\"$provider\"}, model)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Provider & model scorecard",
      "description": "Side-by-side comparison for the selected time range.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (provider, model) (increase(llm_requests_total{job=~\"$service\", provider=~\"$provider\", model=~\"$model\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (provider, model, le) (rate(llm_request_duration_seconds_bucket{job=~\"$service\", provider=~\"$provider\", model=~\"$model\"}[$__range])))",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (provider, model, le) (rate(llm_request_duration_seconds_bucket{job=~\"$service\", provider=~\"$provider\", model=~\"$model\"}[$__range])))",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (provider, model) (rate(llm_requests_total{job=~\"$service\", provider=~\"$provider\", model=~\"$model\", status=\"error\"}[$__range])) / sum by (provider, model) (rate(llm_requests_total{job=~\"$service\", provider=~\"$provider\", model=~\"$model\"}[$__range]))",
          "legendFormat": "",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (provider, model) (increase(llm_tokens_total{job=~\"$service\", provider=~\"$provider\", model=~\"$model\", token_type=\"output\"}[$__range])) / sum by (provider, model) (increase(llm_requests_total{job=~\"$service\", provider=~\"$provider\", model=~\"$model\", status=\"ok\"}[$__range]))",
          "legendFormat": "",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (provider, model) (increase(llm_cost_usd_total{job=~\"$service\", provider=~\"$provider\", model=~\"$model\"}[$__range]))",
          "legendFormat": "",
          "refId": "F",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (provider, model) (increase(llm_cost_usd_total{job=~\"$service\", provider=~\"$provider\", model=~\"$model\"}[$__range])) / sum by (provider, model) (increase(llm_requests_total{job=~\"$service\", provider=~\"$provider\", model=~\"$model\", status=\"ok\"}[$__range]))",
          "legendFormat": "",
          "refId": "G",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Requests",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Requests",
              "Value #B": "p50 latency (s)",
              "Value #C": "p95 latency (s)",
              "Value #D": "Error rate",
              "Value #E": "Avg output tokens",
              "Value #F": "Total cost ($)",
              "Value #G": "Cost / request ($)"
            }
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "barchart",
      "title": "p95 latency by model",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (provider, model, le) (rate(llm_request_duration_seconds_bucket{job=~\"$service\", provider=~\"$provider\", model=~\"$model\"}[$__range])))",
          "legendFormat": "{{provider}}/{{model}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ]
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "barchart",
      "title": "Cost per 1k requests by model",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1000 * sum by (provider, model) (increase(llm_cost_usd_total{job=~\"$service\", provider=~\"$provider\", model=~\"$model\"}[$__range])) / sum by (provider, model) (increase(llm_requests_total{job=~\"$service\", provider=~\"$provider\", model=~\"$model\", status=\"ok\"}[$__range]))",
          "legendFormat": "{{provider}}/{{model}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ]
          }
        }
      ]
    }
  ],
  "links": [
    {
      "title": "LLM dashboards",
      "type": "dashboards",
      "tags": [
        "llm"
      ],
      "asDropdown": true
    }
  ]
}
